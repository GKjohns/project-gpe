AI_GATEWAY_API_KEY=
# DATABASE_URL=postgres://...   # unset = PGlite file in .data/pg/
# NUXT_PUBLIC_APP_URL=http://localhost:3120   # public URL the Method B sandbox posts progress to
# AGENT_LOG_SALT=   # salt for hashed IPs in agent_requests; a fixed dev salt when unset
# INNGEST_EVENT_KEY=   # prod (with INNGEST_SIGNING_KEY); in dev, setting it (any value, e.g. `local`) switches runs to Inngest — see README
# INNGEST_SIGNING_KEY=
# ARXIV_CONTACT_EMAIL=   # optional: adds a mailto contact to the arXiv fetch User-Agent
# VERCEL_OIDC_TOKEN=   # from `vercel env pull` after `vercel link` (render stage and Method B, local only)
# SANDBOX_TEX_SNAPSHOT_ID=   # render stage's TeX snapshot; built on first render and cached in .data/ when unset

# Dev/test: critique adds a low-confidence review item when the model asks nothing (also: retry body { forceReview: true })
# DIGEST_FORCE_REVIEW=1

# Operator auth: the token that unlocks ingest, re-runs, cancel, review decisions, corpus ingests and graph labels
# (sign in at /login). Use a long random value: `openssl rand -base64 32`. Unset in dev = everything open;
# unset in production = those routes are denied (fail closed). Reading, the map, the agent API and the chat stay public.
# OPERATOR_TOKEN=
# Optional: key for the sealed session cookie (32+ chars). Unset = derived from OPERATOR_TOKEN.
# SESSION_SECRET=
# Public chat's daily spend ceiling in USD for non-operators (per function instance), after which the chat says it is
# unavailable until the next UTC day. Non-operators are also limited to 20 turns per IP per hour. Default 5.
# CHAT_DAILY_USD=5
